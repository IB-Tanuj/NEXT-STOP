# Frontend — exposed to the browser. Never put server secrets in VITE_* variables.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# Leave empty when the frontend and API are deployed together on Vercel.
# Set this to https://your-api.example.com when the API is hosted separately.
VITE_API_URL=

# Backend — server-only variables.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Gemini is used by trip generation and the live-data cleanup pipeline.
GEMINI_EXTRA=your-gemini-api-key
# Optional model override. The default is a generally available Flash model.
GEMINI_MODEL=gemini-3.8-flash
# Optional fallback keys for spot information.
GEMINI_KEY=your-gemini-api-key
GEMINI_KEY_1=
GEMINI_KEY_2=
GEMINI_KEY_3=

# Optional live data providers.
TINYFISH_API_KEY=
RAPIDAPI_KEY=
RAPIDAPI_KEY_2=
RAPIDAPI_IMAGES_HOST=
RAPIDAPI_TRAIN_HOST=
RAPIDAPI_FLIGHT_HOST=
RAPIDAPI_HOTEL_HOST=
RAPIDAPI_FLIXBUS_HOST=

